# Velvet Gremlins - Environment Configuration (Testnet Deployment)
# DO NOT commit real private keys or mnemonics to version control.

# TON Network: testnet or mainnet
NETWORK=testnet

# Collection Admin Wallet Address (friendly address e.g. kQD... or 0:...)
# Defaults to the deploying wallet if left blank
COLLECTION_ADMIN_ADDRESS=

# Royalty Recipient Wallet Address (receives 5% secondary sales royalty)
# Defaults to deploying wallet if left blank
COLLECTION_ROYALTY_ADDRESS=

# Founder NFT (#000) Owner Address (receives the 1/1 Founder piece)
FOUNDER_OWNER_ADDRESS=

# Metadata URLs (Off-chain TEP-64 JSON)
# Set these after uploading metadata to decentralized storage (IPFS/Arweave/GitHub)
COLLECTION_METADATA_URI=https://raw.githubusercontent.com/velvet-gremlins/metadata/main/collection.json
COMMON_CONTENT_BASE_URI=https://raw.githubusercontent.com/velvet-gremlins/metadata/main/
FOUNDER_METADATA_URI=velvet-gremlin-000-founder.json

# Deployed Collection Address (filled after running deploy-collection script)
COLLECTION_ADDRESS=
